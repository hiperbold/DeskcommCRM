# Worker de voz (SIP/ARI + IA em tempo real) — mesmo padrão do Dockerfile.worker:
# roda TS direto via tsx (sem build), imagem single-stage com devDeps.
FROM node:22-alpine

WORKDIR /app

LABEL org.opencontainers.image.source="https://github.com/melgarafael/DeskcommCRM" \
      org.opencontainers.image.licenses="MIT" \
      org.opencontainers.image.title="DeskcommCRM voice-agent"

# O processo roda como `node` (abaixo), e o corepack acharia o pnpm no HOME do
# root, não no dele: sem cache baixaria o pnpm de novo a cada boot, e sem rede o
# worker não subiria. COREPACK_HOME fora do HOME, dono `node`, resolve os dois.
ENV COREPACK_HOME=/opt/corepack
RUN corepack enable && corepack prepare pnpm@9.15.9 --activate && chown -R node:node /opt/corepack

COPY package.json pnpm-lock.yaml ./
# `package.json` declara `pnpm.patchedDependencies`, e o pnpm lê o arquivo do
# patch durante o `install` — não no `postinstall`. Sem esta linha ele morre com
# ENOENT em `patches/@react-pdf__hyphenate.patch` e a imagem não nasce.
# `Dockerfile` e `Dockerfile.worker` já copiam; esta era a única que não copiava.
COPY patches ./patches
RUN pnpm install --frozen-lockfile

COPY . .

# A versão por ÚLTIMO, como no Dockerfile.worker. Declarada antes do `pnpm install`,
# a instrução `ARG` entrava na chave de cache de tudo o que vem depois e a
# instalação INTEIRA de dependências era refeita a cada release, só porque o
# número mudou. Aqui ela só invalida o que não custa nada.
ARG APP_VERSION=dev
ENV APP_VERSION=$APP_VERSION

# Produção de verdade, e só DEPOIS do `pnpm install`: com NODE_ENV=production
# antes dele o pnpm descartaria as devDependencies, e o `tsx` é uma delas.
# Sem a variável o worker rodava como desenvolvimento: `lib/env.ts` deixava de
# cobrar as chaves obrigatórias e as travas de destino externo ficavam frouxas (D-135).
ENV NODE_ENV=production

# Sem root: o worker só lê o código e fala pela rede. A imagem node já traz o
# usuário `node`.
USER node

CMD ["pnpm", "exec", "tsx", "workers/voice-agent/index.ts"]
